    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/guideLine0"
        app:layout_constraintBottom_toTopOf="@id/guideLine2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="5dp"
        android:layout_marginStart="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Чёрная линия -->
            <View
                android:id="@+id/black_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"

                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/testText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:text="Текст-мок с вопросом обо всем" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:src="@drawable/placeholder"
                android:visibility="gone"/>

            <View
                android:id="@+id/black_line2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"

                android:layout_marginTop="10dp" />

        </LinearLayout>
    </ScrollView>


    <!-- TextInputLayout-->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideLine2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"


        android:layout_width="0dp"

        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:inputType="text"
        android:textColorHint="@color/gray"
        app:boxBackgroundColor="@color/white"

        app:boxCornerRadiusBottomEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"

        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusTopStart="20dp"

        app:boxStrokeColor="@color/blue"


        app:boxStrokeWidth="2dp"

        app:boxStrokeWidthFocused="0dp"

        app:cursorColor="@color/accent"
        app:endIconMode="custom"
        app:hintEnabled="false"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideLine2">


    <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/testEditText"
            android:padding="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textFilter"

            android:imeOptions="actionDone"
            android:maxLength="50"
            android:hint="Ответ:"
            android:maxLines="1"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottiCheckNo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:lottie_fileName="checkNo.json"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toStartOf="@id/verticalGuideLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideLine2"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottiCheckYes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:lottie_fileName="checkYes.json"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toStartOf="@id/verticalGuideLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideLine2"
        app:layout_constraintBottom_toBottomOf="parent" />






