<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lessonIItem"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:backgroundTint="@color/blue_light"
        android:layout_margin="5dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/lessonVerticalGuideline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"

            app:layout_constraintGuide_percent="0.3"
            />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/lessonVerticalGuideline2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.85"
                />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/lessonHorizontalGuideline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.6"
                />



            <ImageView
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:src="@drawable/placeholder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/lessonVerticalGuideline"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <TextView
                android:id="@+id/lessonDrescription"
                android:textSize="18dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                tools:text="Описание для урока"

                android:gravity="start"
                app:layout_constraintStart_toStartOf="@id/lessonVerticalGuideline"
                 app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/lessonHorizontalGuideline"
                app:layout_constraintEnd_toStartOf="@id/lessonVerticalGuideline2"

               />


            <ImageView
                android:id="@+id/progressStar1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/progressStar2"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:layout_marginBottom="10dp"
                app:layout_constraintStart_toEndOf="@id/lessonVerticalGuideline"
                app:layout_constraintTop_toBottomOf="@id/lessonHorizontalGuideline"
                app:srcCompat="@drawable/save_to_my_lessons_icon" />

            <ImageView
                android:id="@+id/progressStar2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintTop_toTopOf="@id/progressStar1"
                app:layout_constraintBottom_toBottomOf="@id/progressStar1"
                app:layout_constraintStart_toEndOf="@id/progressStar1"
                app:layout_constraintEnd_toStartOf="@id/progressStar3"

                app:srcCompat="@drawable/save_to_my_lessons_icon" />

            <ImageView
                android:id="@+id/progressStar3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintTop_toTopOf="@id/progressStar1"
                app:layout_constraintBottom_toBottomOf="@id/progressStar1"
                app:layout_constraintStart_toEndOf="@id/progressStar2"
                app:layout_constraintEnd_toStartOf="@id/progressStar4"

                app:srcCompat="@drawable/save_to_my_lessons_icon" />

            <ImageView
                android:id="@+id/progressStar4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintTop_toTopOf="@id/progressStar1"
                app:layout_constraintBottom_toBottomOf="@id/progressStar1"
                app:layout_constraintStart_toEndOf="@id/progressStar3"
                app:layout_constraintEnd_toStartOf="@id/progressStar5"

                app:srcCompat="@drawable/save_to_my_lessons_icon" />

            <ImageView
                android:id="@+id/progressStar5"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintTop_toTopOf="@id/progressStar1"
                app:layout_constraintBottom_toBottomOf="@id/progressStar1"
                app:layout_constraintStart_toEndOf="@id/progressStar4"

                app:srcCompat="@drawable/save_to_my_lessons_icon" />

            <ImageView
                android:id="@+id/lessonArrowForward"
                android:layout_margin="15dp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/lessonVerticalGuideline2"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/arrow_forward"/>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>