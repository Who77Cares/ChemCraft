<!-- res/drawable/rounded_corners_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Закругленные углы -->
    <corners android:radius="12dp" /> <!-- Радиус закругления -->

    <!-- Цвет фона -->
    <solid android:color="#FF6200EE" /> <!-- Фиолетовый цвет (можно заменить на любой другой) -->

    <!-- Обводка (опционально) -->
    <stroke
        android:width="1dp"
        android:color="#FF3700B3" /> <!-- Цвет обводки -->
</shape>